# =============================================================================
# Contrato de variables de entorno — PropPelio
# =============================================================================
#
# Este archivo documenta QUE variables existen y de donde sale cada valor.
# NO contiene valores reales y NO se copia a un .env.
#
# El proyecto NO usa archivos .env en disco. Los valores se cargan en:
#
#   Desarrollo  -> GitHub > Settings > Secrets and variables > Codespaces
#                  (en "Repository access" hay que seleccionar PropPelio-)
#   Preview/Prod -> Vercel > Project > Settings > Environment Variables
#
# Paso a paso completo en docs/setup.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Dominio raiz
# -----------------------------------------------------------------------------
# Todo host que sea `<algo>.<este dominio>` se resuelve como un tenant. El
# dominio en si sirve el sitio de marketing.
#
# OPCIONAL: si no se define, vale "localhost:3000", que es lo correcto en
# desarrollo. En Vercel HAY QUE definirla, o el sitio entero se interpreta como
# dominios propios de clientes y nada resuelve.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"


# -----------------------------------------------------------------------------
# Postgres (Supabase)
# -----------------------------------------------------------------------------
# Las dos salen del dashboard de Supabase: boton "Connect" > solapa "ORM" >
# Prisma. Vienen ya armadas, solo hay que reemplazar [YOUR-PASSWORD] por la
# contraseña de la base.
#
# NO usar la solapa "Direct Connection string": esa es IPv6-only y ni
# Codespaces ni Vercel garantizan salida por IPv6.

# Transaction pooler, puerto 6543. La usa la app en runtime (src/lib/db.ts).
# El sufijo ?pgbouncer=true es obligatorio: le avisa a Prisma que no puede
# usar sentencias preparadas.
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler, puerto 5432. Solo la usa el CLI de Prisma para migraciones
# (prisma.config.ts). Las migraciones abren transacciones largas y toman locks,
# cosas que el transaction pooler corta.
DIRECT_URL="postgres://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
# Supabase Auth + Storage
# -----------------------------------------------------------------------------
# Dashboard de Supabase > Settings > API Keys.

# URL del proyecto. Publica.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Publishable key (sb_publishable_...). Publica por diseño: viaja en el bundle
# del browser. No otorga permisos por si misma — lo que se puede leer o
# escribir lo decide el RLS de Postgres.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret key (sb_secret_...).
# ⚠️ BYPASEA TODAS LAS POLITICAS DE RLS. Ve la base entera, todos los tenants.
# Nunca prefijar con NEXT_PUBLIC_. Nunca usar para servir un request de tenant.
# Solo operaciones administrativas (alta de tenants, webhooks, mantenimiento).
SUPABASE_SECRET_KEY="sb_secret_..."
